# All values stay on the server. Never use a VITE_ prefix for these settings.
ASSISTANT_LLM_API_KEY=
# Provider's OpenAI-compatible API base, including its version path if required.
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=
# Required for paid inference in production. Upstash-compatible Redis REST API.
ASSISTANT_RATE_LIMIT_URL=
ASSISTANT_RATE_LIMIT_TOKEN=
ASSISTANT_RATE_LIMIT_PER_MINUTE=8
ASSISTANT_RATE_LIMIT_GLOBAL_PER_MINUTE=60
