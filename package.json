{
  "name": "latest-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build && node scripts/build-route-html.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "cv:pdf": "node scripts/generate-cv-pdf.js",
    "predev": "node scripts/build-assistant-server.js",
    "prebuild": "node scripts/build-assistant-server.js",
    "test:assistant": "node scripts/build-assistant-server.js && node scripts/validate-assistant.js && node scripts/validate-assistant-expansion.js && node scripts/test-assistant-intelligence.js",
    "test:recruiter": "node scripts/validate-recruiter.js",
    "test:recruiter:browser": "node scripts/verify-recruiter-browser.js",
    "test:refresh": "node scripts/validate-evidence-refresh.js && node scripts/validate-portfolio-refresh.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "lucide-react": "^1.39.0",
    "puppeteer": "^25.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
